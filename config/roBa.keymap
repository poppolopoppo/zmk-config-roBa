#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>

#include <dt-bindings/roba/host-os.h>

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <150>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    require-prior-idle-ms = <100>;
};

&sl {
    release-after-ms = <2000>;
    quick-release;
};

&sk {
    release-after-ms = <2000>;
    quick-release;
};

&caps_word { continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>; };

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            timeout-ms = <40>;
            require-prior-idle-ms = <175>;
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            layers = <0>;
        };

        shift_tab {
            timeout-ms = <40>;
            require-prior-idle-ms = <175>;
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
            layers = <0>;
        };

        double_quotation {
            timeout-ms = <40>;
            require-prior-idle-ms = <175>;
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        // Layer-independent mouse clicks: work on every layer, even after the
        // AutoMouse layer expired (no movement needed). require-prior-idle-ms only
        // tracks keyboard key taps (never trackball movement or mkp clicks), so it
        // guards against fast jk/kl rolls during typing without delaying a click
        // after using the ball. Holding the chord keeps the button pressed
        // (click-hold / short drag).
        mb1 {
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            bindings = <&mkp MB1>;
            key-positions = <18 19>;
        };

        mb2 {
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            bindings = <&mkp MB2>;
            key-positions = <19 20>;
        };

        eq {
            timeout-ms = <40>;
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
            layers = <0 2>;
        };

        ctrl+alt+del {
            timeout-ms = <40>;
            require-prior-idle-ms = <175>;
            bindings = <&kp LC(LA(DELETE))>;
            key-positions = <34 42>;
        };

        Gaming {
            timeout-ms = <40>;
            require-prior-idle-ms = <175>;
            bindings = <&tog 8>;
            key-positions = <0 1 8 9>;
        };
    };

    macros {
        mc_clipboard_history: mc_clipboard_history {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(V)>;
            label = "Clipboard History";
        };

        mc_screenshot_linux: mc_screenshot_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(PRINTSCREEN))>;
            label = "Screenshot (Linux)";
        };

        mc_screenshot_windows: mc_screenshot_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(S))>;
            label = "Screenshot (Windows)";
        };

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // Accent macros for both hosts; ac_* selectors choose at runtime.
        // Linux setup: see README.md. Shift selects explicit uppercase sequences.

        // à (Alt+0224)

        ac_agrv_l_linux: ac_agrv_l_linux {
            wait-ms = <5>;
            tap-ms = <5>;
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp K_APPLICATION>,
                <&kp GRAVE>, <&kp A>;
            label = "à";
        };

        ac_agrv_l_windows: ac_agrv_l_windows {
            wait-ms = <5>;
            tap-ms = <5>;
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>, <&kp LALT>,
                <&macro_tap>, <&kp KP_NUMBER_0>,
                <&macro_tap>, <&kp KP_NUMBER_2>,
                <&macro_tap>, <&kp KP_NUMBER_2>,
                <&macro_tap>, <&kp KP_NUMBER_4>,
                <&macro_release>, <&kp LALT>;
            label = "à";
        };

        // À (Alt+0192)

        ac_agrv_u_linux: ac_agrv_u_linux {
            wait-ms = <5>;
            tap-ms = <5>;
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp K_APPLICATION>,
                <&kp GRAVE>, <&kp LS(A)>;
