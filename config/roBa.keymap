            quick-tap-ms = <175>;
            require-prior-idle-ms = <175>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hm_shift_l: homerow-mods-shift-left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hm_shift_r: homerow-mods-shift-right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        msl: layer-tap-with-stick-layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&mo>, <&sl>;
        };

        msk: layer-tap-with-stick-key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&mo>, <&sk>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&mo>, <&to_layer_0>;
        };

        lt_scroll: layer-tap-scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        lt_to_layer_0_space: lt_to_layer_0_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&mo>, <&to_layer_0>;
        };

        ac_agrv: ac_agrv {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ac_agrv_l>, <&ac_agrv_u>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_egrv: ac_egrv {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ac_egrv_l>, <&ac_egrv_u>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_eacu: ac_eacu {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ac_eacu_l>, <&ac_eacu_u>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_ugrv: ac_ugrv {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ac_ugrv_l>, <&ac_ugrv_u>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_ocir: ac_ocir {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ac_ocir_l>, <&ac_ocir_u>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_ccdi: ac_ccdi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ac_ccdi_l>, <&ac_ccdi_u>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Mod-morph consumes outer Shift and selects the _u variant,
        // which sends its own uppercase Compose sequence or Windows Alt-code.
        // Do NOT set keep-mods.

        ac_acir: ac_acir {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ac_acir_l>, <&ac_acir_u>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_ecir: ac_ecir {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ac_ecir_l>, <&ac_ecir_u>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_icir: ac_icir {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ac_icir_l>, <&ac_icir_u>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_ucir: ac_ucir {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ac_ucir_l>, <&ac_ucir_u>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_etrm: ac_etrm {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ac_etrm_l>, <&ac_etrm_u>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_itrm: ac_itrm {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ac_itrm_l>, <&ac_itrm_u>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_utrm: ac_utrm {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ac_utrm_l>, <&ac_utrm_u>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_oe: ac_oe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ac_oe_l>, <&ac_oe_u>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                     &kp W         &kp E         &kp R  &kp T                                                                &kp Y        &kp U          &lt_scroll 5 I  &kp O         &kp P
&kp A                     &kp S         &kp D         &kp F  &kp G  &mc_screenshot                     &kp MINUS                   &kp H        &hm_r RCTRL J  &kp K           &hm_r RALT L  &kp SQT
&hm_shift_l LEFT_SHIFT Z  &kp X         &kp C         &kp V  &kp B  &lt_to_layer_0 9 COLON            &lt_to_layer_0 9 SEMICOLON  &kp N        &kp M          &kp COMMA       &kp DOT       &hm_shift_r RIGHT_SHIFT SLASH
&kp LCTRL                 &kp LEFT_WIN  &kp LEFT_ALT  &mo 6  &mo 2  &lt_to_layer_0_space 3 SPACE      &kp BACKSPACE               &lt 1 ENTER                                               &lt_to_layer_0 7 DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&trans  &trans  &trans  &trans  &trans  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans                          &kp F12
            >;

            sensor-bindings = <&inc_dec_kp TAB LS(TAB)>;
        };

        NUM {
            bindings = <
&kp MINUS          &kp N7  &kp N8  &kp N9  &kp PLUS                                          &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH          &kp N4  &kp N5  &kp N6  &kp ASTERISK  &kp LC(LA(N0))      &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT N0  &kp N1  &kp N2  &kp N3  &kp PERIOD    &kp EQUAL           &kp GRAVE       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans             &trans  &trans  &trans  &trans        &trans              &trans          &trans                                                                     &kp PIPE
            >;

            sensor-bindings = <&inc_dec_kp F3 LS(F3)>;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &mc_undo            &kp LA(UP_ARROW)    &mc_redo             &mc_cut                                   &mc_save_all  &kp LS(TAB)  &kp UP    &kp TAB    &kp BACKSPACE
&kp TAB         &kp LA(LEFT_ARROW)  &kp LA(DOWN_ARROW)  &kp LA(RIGHT_ARROW)  &mc_copy   &trans          &kp PAGE_UP    &kp HOME      &kp LEFT     &kp DOWN  &kp RIGHT  &kp END
&kp LEFT_SHIFT  &kp LG(LEFT_ARROW)  &kp LG(TAB)         &kp LG(RIGHT_ARROW)  &mc_paste  &mc_selall      &kp PAGE_DOWN  &trans        &trans       &trans    &trans     &caps_word
&trans          &trans              &trans              &trans               &trans     &trans          &trans         &trans                                          &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_DOWN) LC(PAGE_UP)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                        &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans    &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans    &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &mkp MB4  &mkp MB5                          &trans
            >;
        };

        SERVICE {
            bindings = <
&mc_task_manager       &kp LS(LC(LG(P)))     &trans                &trans                &host_os ROBA_OS_TOGGLE                                                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp LC(LS(A))         &kp C_PREV            &kp C_PLAY_PAUSE      &kp C_NEXT            &trans                &bootloader               &kp KP_NUMLOCK   &trans        &trans        &mc_clipboard_history        &trans        &trans
&mc_task_1  &mc_task_2  &mc_task_3  &mc_task_4  &mc_task_5  &mc_task_6      &kp PAUSE_BREAK  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans                &trans                &trans                &trans                &trans                &trans                    &trans           &trans                                                  &bt BT_CLR_ALL
            >;
        };

        SNIPE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                        &trans    &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans    &trans    &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans    &trans    &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &mkp MB4  &mkp MB5                                &trans
            >;
        };

        GAMING {
            bindings = <
&kp ESCAPE  &kp N1          &kp N2  &kp N3  &kp N4                           &kp N5     &kp N6  &kp N7  &kp N8    &kp N9
&kp TAB     &kp Q           &kp W   &kp E   &kp R   &kp T          &kp Y     &kp U      &kp I   &kp O   &kp P     &kp LBKT
&kp LSHFT   &kp A           &kp S   &kp D   &kp F   &kp G          &kp H     &kp J      &kp K   &kp L   &kp SEMI  &kp APOS
&kp LCTRL   &mt LEFT_ALT Z  &kp X   &kp C   &kp V   &kp SPACE      &kp BSPC  &kp ENTER                            &kp LALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        // ACCENTS: SERVICE+T toggles Linux / Windows; Linux is selected at boot.
        // Linux Compose needs compose:menu; Windows needs NumLock ON.
        ACCENTS {
            bindings = <
&ac_acir  &ac_egrv  &ac_eacu  &ac_ecir  &trans                        &ac_euro  &ac_ugrv  &ac_icir  &ac_ocir  &ac_oe
&ac_agrv  &trans    &trans    &trans    &trans    &trans      &trans    &ac_ucir  &trans    &ac_itrm  &trans    &trans
&trans    &trans    &ac_ccdi  &trans    &trans    &trans      &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans      &trans    &trans                                          &trans
            >;
        };
    };
};
